{
    "name": "fast-food-auth",
    "version": "1.0.0",
    "description": "Lambda auth do Tech Challenge do curso SOAT FIAP",
    "main": "src/main/index.ts",
    "author": "Grupo 277",
    "scripts": {
        "build": "npm run build:clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:clean": "rimraf dist",
        "build:package": "./build-package.sh",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage --reporter=verbose",
        "dev": "tsx watch src/main/index.ts",
        "start": "npm run build && node dist/main/index.js",
        "lint": "tsc && eslint ./src/**/*.ts",
        "lint:fix": "eslint ./src/**/*.ts --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "terraform:init": "cd terraform && terraform init",
        "terraform:plan": "cd terraform && terraform plan -var=\"lambda_filename=../lambda-deployment.zip\"",
        "terraform:apply": "cd terraform && terraform apply -var=\"lambda_filename=../lambda-deployment.zip\"",
        "terraform:destroy": "cd terraform && terraform destroy -var=\"lambda_filename=../lambda-deployment.zip\"",
        "deploy:local": "npm run build && npm run build:package",
        "deploy:aws": "npm run deploy:local && npm run terraform:apply",
        "test:local": "curl -X POST http://localhost:3000/auth -H \"Content-Type: application/json\" -d '{\"cpf\":\"12345678901\"}'",
        "clean": "npm run build:clean && rm -f lambda-deployment.zip"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/laahundskarl/fast-food-auth.git"
    },
    "keywords": [],
    "license": "ISC",
    "homepage": "https://github.com/laahundskarl/fast-food-auth#readme",
    "engineStrict": true,
    "engines": {
        "node": ">=22"
    },
    "prisma": {
        "schema": "src/infrastructure/database/prisma/schema.prisma"
    },
    "dependencies": {
        "@fastify/aws-lambda": "^6.1.1",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^5.2.2",
        "cpf-cnpj-validator": "^1.0.3",
        "dotenv": "^16.5.0",
        "fastify": "^5.6.1",
        "fastify-type-provider-zod": "^4.0.2",
        "http-status-codes": "^2.3.0",
        "inversify": "^7.10.2",
        "jsonwebtoken": "^9.0.2",
        "pino": "^10.1.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@types/aws-lambda": "^8.10.155",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.15.18",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@typescript-eslint/parser": "^8.32.1",
        "@vitest/coverage-v8": "4.0.16",
        "eslint": "^9.27.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-import-resolver-typescript": "^4.3.4",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.4.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.32.1",
        "vitest": "^4.0.16"
    }
}
